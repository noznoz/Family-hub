# ─────────────────────────────────────────────────────────────
# Family Hub — Environment Configuration
# Copy to .env.local and fill with YOUR OWN independent Supabase
# project values. Do NOT reuse any other project's credentials.
# ─────────────────────────────────────────────────────────────

# Public app URL (used for PWA, redirects, metadata).
# Dev: http://localhost:3000  ·  Prod: https://your-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production custom domain (configurable; used in metadata later).
NEXT_PUBLIC_PRODUCTION_DOMAIN=

# Supabase (independent Family Hub project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — NEVER expose to the browser.
# Used for admin/seed operations only.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names
NEXT_PUBLIC_SUPABASE_DOCS_BUCKET=documents
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
